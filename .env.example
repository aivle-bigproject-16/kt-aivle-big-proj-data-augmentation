# quality-fail-augment 실행 경로 설정
#
# 이 파일을 `.env` 로 복사한 뒤 자기 머신의 경로로 바꿔 쓴다. `.env` 는
# git 에 올라가지 않는다. 값에 이스케이프 처리를 하지 않으므로 Windows 경로는
# 백슬래시 그대로 적으면 된다. 셸에 같은 이름의 환경변수가 이미 있으면
# 그쪽이 우선한다.

# 원본 데이터 루트. 이 폴더 바로 아래에 `3.개방데이터` 가 있어야 한다.
QFA_RAW_ROOT=E:\103.배터리 불량 이미지 데이터

# 사용할 config JSON. 저장소 상대경로도 된다.
QFA_CONFIG=./config.40k.json

# plan 출력 폴더
QFA_PLAN_DIR=E:\quality-fail-v2-plan

# 전체 생성 출력 폴더. `verify` 도 이 값을 기본으로 쓴다.
QFA_OUTPUT_DIR=E:\quality-fail-v2-output

# smoke 생성 출력 폴더 (run_pipeline.ps1 의 smoke 단계 기본값)
QFA_SMOKE_DIR=E:\quality-fail-v2-smoke

# audit-raw 출력 폴더
QFA_AUDIT_DIR=E:\quality-fail-v2-audit

# generate 가 읽을 plan CSV 를 직접 지정하고 싶을 때만 쓴다.
# 비워두면 QFA_PLAN_DIR\manifests\generation_plan.csv 를 쓴다.
# QFA_PLAN_CSV=E:\quality-fail-v2-plan\manifests\generation_plan.csv
